# 编译产物
*.exe
*.exe~

# 数据库文件（包含敏感账号信息）
*.db

# 日志文件
*.log

# 大文件 - ONNX Runtime DLL（从 onnxruntime Python 包或 GitHub Releases 获取）
lib/onnxruntime.dll

# 大文件 - OCR 模型权重（从 ddddocr Python 包获取）
ddddocr_weights/*.onnx

# Chrome 临时用户数据目录
autologin-chrome-*

# Python 缓存
__pycache__/
*.pyc

# IDE / 编辑器
.vscode/
.idea/
.trae-cn/

# OS 文件
.DS_Store
Thumbs.db

# 临时文件
*.tmp
*.bak
